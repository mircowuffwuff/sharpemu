{
    "emulator": "sharpemu",
    "name": "Render pass batching",
    "notes": "android plus render pass batching. a parked topic branch that joins nothing: a per-draw global-memory barrier refuses every join, so the change is measured and merged nowhere.",
    "hostSeams": ["window", "audio"],
    "env": {"SHARPEMU_BATCH_RENDER_PASSES": "1"},
    "bootCheckpoints": [
        { "pattern": "SharpEmu starting", "description": "Starting SharpEmu…" },
        { "pattern": "Creating runtime", "description": "Preparing the runtime…" },
        { "pattern": "Kernel TSC frequency", "description": "Calibrating the clock…" },
        { "pattern": "host address space:", "description": "Reserving memory for the game…" },
        { "pattern": "type initializers", "description": "Warming up the emulator…" },
        { "pattern": "[LOADER] Title:", "description": "Reading the game…", "gameStarts": true },
        { "pattern": "module(s)...", "description": "Loading modules…" },
        { "pattern": "=== Execute START ===", "description": "Starting the game…" },
        { "pattern": "Scheduled guest thread", "description": "Starting the game…" },
        { "pattern": "Vulkan VideoOut ready", "description": "Preparing the display…" }
    ]
}
